<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every shape the importer has to preserve rather than represent, in one file: spec-level metadata
  the builder has no field for, a requirement facet outside its model, and one specification whose
  applicability makes it unshowable at all. The author's annotation is here for the opposite reason
  now — it is carried on the value it documents, and the round trip has to put it back as the
  restriction's first child, where ids.xsd fixes it.
  Trimmed from the patterns found across the goal 3a corpus; not copied from any single file.

  The facet kept verbatim states two restriction families on one value — a range and an enumeration,
  which XSD intersects and a ValueDraft cannot. 3 corpus facets do this. It has to be something
  really unrepresentable: the classification, the material, the bound and the pattern-valued baseName
  this file used to keep are all read now, and a fixture whose "kept" facet has quietly become
  representable stops testing the thing it was written for.

  The whole specification kept verbatim names its entity types with an xs:pattern. 12 corpus
  specifications do this, and it is the applicability the builder cannot show for a structural
  reason rather than a pending one: it offers a list of type chips, and a pattern names an
  open-ended set of classes. It used to be a classification applicability, which is read now.
-->
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <info>
    <title>Mixed fidelity</title>
    <version>1.1</version>
    <author>taco@mepover.com</author>
    <date>2026-08-06</date>
  </info>
  <specifications>
    <specification name="Walls carry a name and a type code" identifier="S1" ifcVersion="IFC2X3 IFC4" description="Spec-level prose the builder has no field for." instructions="Fill these in from the wall schedule.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCWALL</simpleValue></name></entity>
      </applicability>
      <requirements description="Requirement-level prose, which lives on the element itself.">
        <attribute cardinality="required">
          <name><simpleValue>Name</simpleValue></name>
        </attribute>
        <property dataType="IFCTEXT">
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>Reference</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:string">
              <xs:pattern value="W-.*" />
            </xs:restriction>
          </value>
        </property>
        <property>
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>Status</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="New" />
              <xs:enumeration value="Existing" />
            </xs:restriction>
          </value>
        </property>
        <classification>
          <value><simpleValue>21.22</simpleValue></value>
          <system><simpleValue>NL/SfB</simpleValue></system>
        </classification>
        <property dataType="IFCTHERMALTRANSMITTANCEMEASURE">
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>ThermalTransmittance</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:double">
              <xs:maxInclusive value="0.24" />
            </xs:restriction>
          </value>
        </property>
        <property dataType="IFCLABEL" cardinality="optional">
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>AcousticRating</simpleValue></baseName>
        </property>
        <attribute cardinality="prohibited">
          <name><simpleValue>Description</simpleValue></name>
        </attribute>
        <material>
          <value><simpleValue>Concrete</simpleValue></value>
        </material>
        <property>
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>LoadBearing</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:double">
              <xs:minInclusive value="0" />
              <xs:enumeration value="1" />
            </xs:restriction>
          </value>
        </property>
      </requirements>
    </specification>
    <specification name="Doors are documented" ifcVersion="IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute>
          <name><simpleValue>Name</simpleValue></name>
          <value>
            <xs:restriction base="xs:string">
              <xs:annotation>
                <xs:documentation>Any name beginning with D-, e.g. D-01.</xs:documentation>
              </xs:annotation>
              <xs:pattern value="D\-.*" />
            </xs:restriction>
          </value>
        </attribute>
        <attribute cardinality="prohibited">
          <name><simpleValue>Tag</simpleValue></name>
          <value><simpleValue>TODO</simpleValue></value>
        </attribute>
      </requirements>
    </specification>
    <specification name="Everything with a wall-ish class is named" ifcVersion="IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:pattern value="IFCWALL.*" />
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute>
          <name><simpleValue>Name</simpleValue></name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Some storey must exist" ifcVersion="IFC4">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity>
      </applicability>
    </specification>
  </specifications>
</ids>
