ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('geom-wall.ifc','2026-07-29T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaa1',$,'Project',$,$,$,$,(#20),#30);
#2=IFCSITE('0aaaaaaaaaaaaaaaaaaaa2',$,'Site',$,$,#40,$,$,.ELEMENT.,$,$,$,$,$);
#3=IFCBUILDING('0aaaaaaaaaaaaaaaaaaaa3',$,'Building',$,$,#41,$,$,.ELEMENT.,$,$,$);
#4=IFCBUILDINGSTOREY('0aaaaaaaaaaaaaaaaaaaa4',$,'Level 1',$,$,#42,$,$,.ELEMENT.,0.);
#5=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa5',$,$,$,#1,(#2));
#6=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa6',$,$,$,#2,(#3));
#7=IFCRELAGGREGATES('0aaaaaaaaaaaaaaaaaaaa7',$,$,$,#3,(#4));
#8=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aaaaaaaaaaaaaaaaaaaa8',$,$,$,(#100,#200),#4);

#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCDIRECTION((0.,1.,0.));

#20=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,$);
#21=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#20,$,.MODEL_VIEW.,$);

#30=IFCUNITASSIGNMENT((#31,#32,#33));
#31=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#32=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#33=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);

#40=IFCLOCALPLACEMENT($,#13);
#41=IFCLOCALPLACEMENT(#40,#13);
#42=IFCLOCALPLACEMENT(#41,#13);

/* Wall A: a 4000 x 200 x 3000 box at the origin. */
#100=IFCWALL('0aaaaaaaaaaaaaaaaaaa10',$,'Wall A',$,$,#101,#110,$,$);
#101=IFCLOCALPLACEMENT(#42,#102);
#102=IFCAXIS2PLACEMENT3D(#103,#11,#12);
#103=IFCCARTESIANPOINT((0.,0.,0.));
#110=IFCPRODUCTDEFINITIONSHAPE($,$,(#111));
#111=IFCSHAPEREPRESENTATION(#21,'Body','SweptSolid',(#112));
#112=IFCEXTRUDEDAREASOLID(#113,#118,#11,3000.);
#113=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#114);
#114=IFCPOLYLINE((#115,#116,#117,#119,#115));
#115=IFCCARTESIANPOINT((0.,0.));
#116=IFCCARTESIANPOINT((4000.,0.));
#117=IFCCARTESIANPOINT((4000.,200.));
#119=IFCCARTESIANPOINT((0.,200.));
#118=IFCAXIS2PLACEMENT3D(#10,#11,#12);

/* Wall B: the same box, moved 5 m along X, so two distinct meshes exist. */
#200=IFCWALL('0aaaaaaaaaaaaaaaaaaa20',$,'Wall B',$,$,#201,#210,$,$);
#201=IFCLOCALPLACEMENT(#42,#202);
#202=IFCAXIS2PLACEMENT3D(#203,#11,#12);
#203=IFCCARTESIANPOINT((5000.,0.,0.));
#210=IFCPRODUCTDEFINITIONSHAPE($,$,(#211));
#211=IFCSHAPEREPRESENTATION(#21,'Body','SweptSolid',(#212));
#212=IFCEXTRUDEDAREASOLID(#113,#118,#11,3000.);
ENDSEC;
END-ISO-10303-21;
