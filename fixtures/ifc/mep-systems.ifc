#64=IFCPROPERTYSINGLEVALUE('SystemAbbreviation',$,IFCLABEL('CHW'),$);
#65=IFCPROPERTYSINGLEVALUE('Insulation',$,IFCLABEL('19mm'),$);
#66=IFCPROPERTYSET('0MEP8vE59Jw4qLKrVeS02',$,'Pset_MEPCommon',$,(#64,#65));
#67=IFCRELDEFINESBYPROPERTIES('2MEP9wF60Kx5rMLsWfT02',$,$,$,(#22,#23,#26,#27,#28,#33),#66);

#68=IFCPROPERTYSINGLEVALUE('FireRating',$,IFCLABEL('120'),$);
#69=IFCPROPERTYSET('0MEP8vE59Jw4qLKrVeS03',$,'Pset_DamperOccurrence',$,(#68));
#70=IFCRELDEFINESBYPROPERTIES('2MEP9wF60Kx5rMLsWfT03',$,$,$,(#29),#69);

#71=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.F.),$);
#72=IFCPROPERTYSINGLEVALUE('FireRating',$,IFCLABEL('60'),$);
#73=IFCPROPERTYSET('0MEP8vE59Jw4qLKrVeS04',$,'Pset_WallCommon',$,(#71,#72));
#74=IFCRELDEFINESBYPROPERTIES('2MEP9wF60Kx5rMLsWfT04',$,$,$,(#40,#41),#73);

#80=IFCRELAGGREGATES('3MEPO0xG71Ly6sNMtXgUV1',$,$,$,#1,(#11));
#81=IFCRELAGGREGATES('4MEPP1yH82Mz7tONuYhVW1',$,$,$,#11,(#13));
