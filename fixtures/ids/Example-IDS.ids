      <classification>
        <value>
          <xs:restriction base="xs:string">
            <xs:pattern value="^\d{2}\.(?!00)\d{2}$" />
          </xs:restriction>
        </value>
        <system>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Uniformat" />
            <xs:enumeration value="Default Classification" />
            <xs:enumeration value="NL-SfB" />
          </xs:restriction>
        </system>
      </classification>
      </requirements>
