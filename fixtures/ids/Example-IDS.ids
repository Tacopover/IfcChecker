  <info>
    <title>Example IDS</title>
    <date>2026-08-21</date>
  </info>
  <specifications>
    <specification name="IfcBuildingElementProxy forbidden" ifcVersion="IFC2X3 IFC4">
      <applicability minOccurs="0" maxOccurs="0">
        <entity><name><simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue></name></entity>
      </applicability>
      <requirements>
      </requirements>
    </specification>
    <specification name="Level check" ifcVersion="IFC2X3 IFC4" description="Check if building storeys start with 2 numeric values">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity>
      </applicability>
      <requirements>
      <attribute>
        <name><simpleValue>Name</simpleValue></name>
        <value>
          <xs:restriction base="xs:string">
            <xs:pattern value="^\d{2}" />
          </xs:restriction>
        </value>
      </attribute>
      </requirements>
    </specification>
    <specification name="Site name is correct" ifcVersion="IFC2X3 IFC4">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSITE</simpleValue></name></entity>
      </applicability>
      <requirements>
      <attribute>
        <name><simpleValue>Name</simpleValue></name>
        <value><simpleValue>Fill in Site Name here</simpleValue></value>
      </attribute>
      </requirements>
    </specification>
    <specification name="Material must exist" ifcVersion="IFC2X3 IFC4">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCBUILDINGELEMENTPROXY" />
              <xs:enumeration value="IFCFLOWFITTING" />
              <xs:enumeration value="IFCFLOWSEGMENT" />
              <xs:enumeration value="IFCFLOWTERMINAL" />
              <xs:enumeration value="IFCMECHANICALFASTENER" />
              <xs:enumeration value="IFCFLOWMOVINGDEVICE" />
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
      <material>
      </material>
      </requirements>
    </specification>
